{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question",
  "type": "object",
  "required": [
    "question_id",
    "exam",
    "subject",
    "unit",
    "chapter",
    "chapter_id",
    "topic",
    "type",
    "difficulty",
    "question_text",
    "options",
    "correct_answer",
    "explanation",
    "is_pyq"
  ],
  "properties": {
    "question_id": { "type": "string", "minLength": 1 },
    "exam": { "type": "string", "enum": ["NEET", "JEE_MAINS", "JEE_ADV"] },
    "subject": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "chapter": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "topic": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["MCQ_SINGLE", "MCQ_MULTI", "NUMERICAL", "ASSERTION_REASON"]
    },
    "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
    "question_text": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0,
      "maxItems": 4
    },
    "correct_answer": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" }
      ]
    },
    "explanation": { "type": "string" },
    "is_pyq": { "type": "boolean" },
    "pyq_year": { "type": ["integer", "null"], "minimum": 1990, "maximum": 2030 },
    "image_url": { "type": ["string", "null"] }
  },
  "additionalProperties": false,
  "if": {
    "properties": { "type": { "const": "NUMERICAL" } }
  },
  "then": {
    "properties": { "options": { "maxItems": 0 } }
  },
  "else": {
    "properties": { "options": { "minItems": 4 } }
  }
}
