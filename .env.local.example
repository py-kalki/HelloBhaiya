# ─────────────────────────────────────────────────────────────────
# HelloBhaiya — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Firebase Client (NEXT_PUBLIC — safe to expose) ───────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=         # FCM web push public key

# ── App URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Analytics & Monitoring (NEXT_PUBLIC — safe) ──────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─────────────────────────────────────────────────────────────────
# SERVER-ONLY — NEVER add NEXT_PUBLIC_ prefix to anything below
# ─────────────────────────────────────────────────────────────────

# Firebase Admin SDK (JSON stringified service account)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Key
# Then: JSON.stringify(require('./serviceAccount.json'))
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# Anthropic Claude API — AI Doubt Solver (Phase 2)
ANTHROPIC_API_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Sentry — error monitoring
SENTRY_DSN=
