rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      match /tests/{testId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid;
        allow write: if false; // Server Action (Admin SDK) only
      }

      match /templates/{templateId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /timetable/{dayId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /dailyGoal {
        allow read: if request.auth != null
                    && request.auth.uid == uid;
        allow write: if false; // Server Action only
      }
    }

    // ── Question bank ──────────────────────────────────────────────────
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ── Notes library ──────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only

      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.uid == uid;
      }
    }

    // ── Battles (Phase 3) ──────────────────────────────────────────────
    match /battles/{battleId} {
      allow read, write: if request.auth != null
                         && (resource == null
                             || request.auth.uid == resource.data.player1_uid
                             || request.auth.uid == resource.data.player2_uid);
    }

    // ── Leaderboard ────────────────────────────────────────────────────
    match /leaderboard/weekly/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // Server Action only
    }

    match /leaderboard/archive/{weekId}/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Function only
    }
  }
}
